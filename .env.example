# Kripto Bot — Ortam Degiskenleri
# Kopyala: cp .env.example .env  ve gercek degerleri yaz
# UYARI: .env dosyasini asla gite commit etme!

# Borsa API (su an gerekmiyor — paper mode)
# Sadece Trade izni ver, Withdrawal izni VERME!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_NAME=binance

# Telegram Bildirim (opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot Ayarlari
INITIAL_CAPITAL=1000
BOT_MODE=M5
COINS=15
